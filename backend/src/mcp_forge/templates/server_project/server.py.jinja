"""MCP Server entrypoint generated by MCP Forge."""

import asyncio
import json
import os
from pathlib import Path
import sys
from typing import Any

from mcp.server.mcpserver import MCPServer
from mcp.server.transport_security import TransportSecuritySettings
from mcp.types import ToolAnnotations
from pydantic import BaseModel, ConfigDict

from runtime import (
    ApiClient,
    RuntimeConfig,
    apply_auth,
    build_request,
    check_rate_limit,
    log,
)

# Load manifest
MANIFEST_PATH = Path(__file__).parent / "tools.json"
with open(MANIFEST_PATH, encoding="utf-8") as f:
    manifest: dict[str, Any] = json.load(f)

server_info = manifest.get("info", {})
server_name = server_info.get("title", "MCP Server")
server = MCPServer(name=server_name)

# Runtime config & client
config = RuntimeConfig.from_env(default_base_url=server_info.get("base_url", ""))
api_client = ApiClient(config)


class DynamicArgs(BaseModel):
    """Pydantic model allowing arbitrary validated arguments from MCP clients."""

    model_config = ConfigDict(extra="allow")

    def model_dump_one_level(self) -> dict[str, Any]:
        return self.model_dump()


def _create_tool_handler(tool_def: dict[str, Any]) -> Any:
    """Create a closure for dispatching an operation."""
    tool_name = tool_def["name"]
    tool_path = tool_def["path"]
    tool_method = tool_def["method"]
    param_locs = tool_def.get("param_locations", {})
    is_flattened = tool_def.get("is_flattened_body", False)
    sec_reqs = tool_def.get("security", [])

    async def handler(**arguments: Any) -> str:
        # 1. Rate limiting check
        allowed, err_msg = check_rate_limit(tool_name)
        if not allowed:
            return err_msg

        # 2. Build HTTP request components
        final_url, query_params, headers, json_body, form_body = build_request(
            base_url=config.base_url,
            path_template=tool_path,
            arguments=arguments,
            param_locations=param_locs,
            is_flattened_body=is_flattened,
        )

        # 3. Apply authentication credentials
        cookies: dict[str, str] = {}
        http_client = await api_client.get_client()
        await apply_auth(
            security_requirements=sec_reqs,
            auth_definitions=manifest.get("auth", {}),
            headers=headers,
            query_params=query_params,
            cookies=cookies,
            client=http_client,
        )

        # 4. Dispatch request
        return await api_client.execute_request(
            method=tool_method,
            url=final_url,
            query_params=query_params,
            headers=headers,
            cookies=cookies,
            json_body=json_body,
            form_body=form_body,
            tool_name=tool_name,
        )

    handler.__name__ = tool_name
    handler.__doc__ = tool_def.get("description", "")
    return handler


# Register all tools from tools.json
for tool_def in manifest.get("tools", []):
    t_name = tool_def["name"]
    t_desc = tool_def.get("description", "")
    t_annotations = ToolAnnotations(**tool_def.get("annotations", {}))

    handler_fn = _create_tool_handler(tool_def)
    server.add_tool(
        handler_fn,
        name=t_name,
        description=t_desc,
        annotations=t_annotations,
    )

    # Patch schema and model validator on registered tool
    tool_obj = server._tool_manager.get_tool(t_name)
    tool_obj.fn_metadata.arg_model = DynamicArgs
    tool_obj.parameters = tool_def.get("input_schema", {"type": "object", "properties": {}})


def main() -> None:
    """Run the server using either stdio or Streamable HTTP transport."""
    transport = os.environ.get("MCP_TRANSPORT", "stdio").lower()
    if len(sys.argv) > 1 and sys.argv[1] in ("--http", "--streamable-http"):
        transport = "streamable-http"

    if transport == "streamable-http":
        host = os.environ.get("HOST", "127.0.0.1")
        port = int(os.environ.get("PORT", "8000"))
        auth_token = os.environ.get("MCP_AUTH_TOKEN", "").strip()

        # Enforce security rule: non-loopback bind requires auth token
        is_loopback = host in ("127.0.0.1", "localhost", "::1", "[::1]")
        if not is_loopback and not auth_token:
            msg = "FATAL: Binding to a non-loopback address requires setting MCP_AUTH_TOKEN."
            sys.stderr.write(msg + "\n")
            sys.exit(1)

        allowed_hosts = [host, "127.0.0.1", "localhost", "[::1]"]
        allowed_origins = os.environ.get("ALLOWED_ORIGINS", "").split(",")
        allowed_origins = [o.strip() for o in allowed_origins if o.strip()]

        sec_settings = TransportSecuritySettings(
            enable_dns_rebinding_protection=True,
            allowed_hosts=allowed_hosts,
            allowed_origins=allowed_origins if allowed_origins else None,
        )

        log("INFO", f"Starting Streamable HTTP transport on http://{host}:{port}/mcp")
        asyncio.run(
            server.run_streamable_http_async(
                host=host,
                port=port,
                transport_security=sec_settings,
            )
        )
    else:
        log("INFO", "Starting stdio transport")
        asyncio.run(server.run_stdio_async())


if __name__ == "__main__":
    main()
