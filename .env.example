# MCP Forge Configuration
# See docs/06-deployment.md for details

ENV=production
FORGE_MODE=local
FORGE_HOST=127.0.0.1
FORGE_PORT=8080
FORGE_PUBLIC_HOST=
FORGE_ACCESS_TOKEN=
FORGE_DATA_DIR=./data
DATABASE_URL=
MAX_SPEC_BYTES=10485760
PIPELINE_TIMEOUT_S=30
PLAYGROUND_ENABLED=true
PLAYGROUND_MAX_SESSIONS=3
PLAYGROUND_IDLE_TIMEOUT_S=900
TRACE_RETENTION_DAYS=7
ALLOW_PRIVATE_SPEC_URLS=false
ALLOW_REMOTE_REFS=false
LOG_LEVEL=info
